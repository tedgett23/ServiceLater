POSTGRES_PASSWORD=change-me
SL_TLS=off
# Required for the api role, >= 32 chars, same on every api replica: openssl rand -base64 48
SL_JWT_SECRET=
# Encrypts stored secrets (the mail server password, S3 keys, single sign-on client secrets). Same on every api and
# worker; keep a copy, since without it those secrets cannot be read: servicelater secrets gen-key
SL_SECRETS_KEY=
# Optional: creates the first admin when the users table is empty (change the password after first login)
SL_BOOTSTRAP_ADMIN_EMAIL=
SL_BOOTSTRAP_ADMIN_PASSWORD=
SL_DOMAIN=
SL_DATABASE_URL=postgres://servicelater:servicelater@localhost:5432/servicelater?sslmode=disable
# The image Compose runs (deploy/compose); built from this checkout with `make image` when it is not there.
# SL_IMAGE=servicelater:latest
# SL_ROLES=all            # all | comma list of web,api,worker
# SL_API_URL=             # web role only: proxy /api and /ws here
# SL_TLS=off              # off | auto (needs SL_DOMAIN) | files (needs SL_TLS_CERT, SL_TLS_KEY)
# First-party apps installed and upgraded at startup: unset (all seven: core-itsm, incident-management,
# change-management, cmdb, knowledge-base, service-catalog, problem-management), none, or a comma list
# SL_BUNDLED_APPS=
# Your own changes to apps, one folder per app, laid out like an app's local/ folder. Keep it on a volume.
# SL_APPS_LOCAL_DIR=/data/apps-local
# Where attachments are kept when Admin > Storage says "folder"; the same folder on every api and worker.
# SL_ATTACHMENTS_DIR=/data/attachments
